# ============================================================
# OpenAgentPlatform - Environment Configuration
# ============================================================
# Copy this file to .env and adjust as needed for your environment.
# All defaults are suitable for local development.

# ============================================================
# Application
# ============================================================
# Environment: development | staging | production
APP_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# HTTP server port
HTTP_PORT=8080

# ============================================================
# Ozore AI — hosted LLM agent provider (OpenAI-compatible API)
# ============================================================
# Your API key from the Ozore dashboard
OZORE_API_KEY=
# Model identifier (e.g. ozore/custom)
OZORE_MODEL=ozore/custom
# Base URL for the Ozore API
OZORE_BASE_URL=https://ozore.com/v1

# ============================================================
# Database (PostgreSQL + TimescaleDB)
# ============================================================
# Connection string for the OAP server
# Format: postgres://user:password@host:port/dbname?sslmode=disable
POSTGRES_DSN=postgres://oap:oap@localhost:5432/oap?sslmode=disable

# Individual connection parameters (used by Docker Compose)
POSTGRES_USER=oap
POSTGRES_PASSWORD=oap
POSTGRES_DB=oap
POSTGRES_PORT=5432

# ============================================================
# NATS (Message Broker)
# ============================================================
# Connection URL for the OAP server and agents (non-docker runs).
# docker-compose.yml does NOT read this: nats.conf enforces mTLS, so the
# compose server service hardcodes
#   tls://oap-server:${OAP_SERVER_PASSWORD}@nats:4222
# plus the client cert/key mounts under deploy/nats/certs/. A plain
# nats:// URL against the compose nats fails with "Authorization Violation".
NATS_URL=nats://localhost:4222

# mTLS certificates (leave blank for local dev without TLS)
# Generate with: ./deploy/nats/scripts/gen-certs.sh
# (also mints oap-server-client-cert/key.pem used by the compose server)
# NATS_CERT_FILE=
# NATS_KEY_FILE=
# NATS_CA_FILE=

# NATS monitoring port
NATS_MONITOR_PORT=8222

# NATS account passwords (used by docker-compose for nats.conf)
# Generate with: openssl rand -hex 32
SYS_PASSWORD=change-me-sys-password
OAP_SERVER_PASSWORD=change-me-oap-server-password
AGENT_LOCAL_PASSWORD=change-me-agent-local-password
A2A_GATEWAY_PASSWORD=change-me-a2a-gateway-password

# ============================================================
# OIDC (Authentication via Dex)
# ============================================================
# Dex issuer URL as the SERVER sees it. coreos/go-oidc requires the discovered
# "issuer" to equal this URL EXACTLY: inside the compose network that is
# http://dex:5556/dex (dex's config.yaml issuer); http://localhost:5556/dex is
# only correct when the server runs outside docker talking to a port-forwarded
# dex. A mismatch breaks provider discovery and blocks every login.
OIDC_ISSUER_URL=http://dex:5556/dex

# OAuth client credentials (must match Dex config)
OIDC_CLIENT_ID=oap-web
OIDC_CLIENT_SECRET=oap-web-secret

# Where the browser lands after a successful login. "/" resolves against the
# origin the browser used (web UI on :5173 via nginx proxy, or server :8080).
# Do NOT reuse OIDC_REDIRECT_URL's value here — that must stay the dex-
# registered /auth/callback for the code exchange.
POST_LOGIN_REDIRECT_URL=/

# Server applies the embedded canonical schema (internal/db/migrations) at
# boot. Default true for beta; set false for a DBA-managed database, which
# then rolls out with `go run ./cmd/migrate up`.
OAP_AUTO_MIGRATE=true

# One-time first-boot bootstrap token (auth-rbac spec §14). Guards
# POST /api/v1/auth/bootstrap, which creates the first org and binds the
# calling admin to it. Empty (default) disables the endpoint entirely.
# Generate something like: openssl rand -hex 32
# BOOTSTRAP_TOKEN=

# OIDC provider redirect_uri registered in dex (staticClients in
# deploy/dex/config.yaml). Leave as-is unless you change the callback route.
# OIDC_REDIRECT_URL=http://localhost:8080/auth/callback

# Dex web UI port
DEX_PORT=5556

# ============================================================
# Session & Security
# ============================================================
# JWT signing secret (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-in-production-use-openssl-rand-hex-32

# Cookie configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Session timeout (hours)
SESSION_TIMEOUT=24

# ============================================================
# Web UI
# ============================================================
# Vite dev server port
VITE_PORT=5173

# API URL for the web frontend
VITE_API_URL=http://localhost:8080

# ============================================================
# Observability (Optional)
# ============================================================
# Sentry DSN for error tracking
# SENTRY_DSN=

# Prometheus metrics port
# METRICS_PORT=9090

# ============================================================
# Agent Configuration
# ============================================================
# Default agent log level
AGENT_LOG_LEVEL=info

# Agent heartbeat interval (seconds)
AGENT_HEARTBEAT_INTERVAL=30

# ============================================================
# Feature Flags
# ============================================================
# Enable experimental features
ENABLE_A2A=true
ENABLE_LLM_AGENTS=false
