# syntax=docker/dockerfile:1
#
# Multi-stage build for the OpenAgentPlatform API server (cmd/server).
# Build context is the repo root (see deploy/docker-compose.yml: context: ..).

# ---------- build stage ----------
FROM golang:1.26.3-alpine AS build
WORKDIR /src

# Cache module downloads. go.work selects the root module (cmd/server and
# friends); copy module files first so deps cache independently of source.
COPY go.mod go.sum ./
COPY go.work ./
RUN go mod download

# Copy the rest of the source and build the server binary.
COPY . .
RUN CGO_ENABLED=0 go build -o /out/oap-server ./cmd/server

# ---------- runtime stage ----------
FROM alpine:3.20 AS runtime
RUN apk add --no-cache ca-certificates wget
WORKDIR /app
COPY --from=build /out/oap-server /app/oap-server

ENV HTTP_PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget -q --spider http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/app/oap-server"]
