# syntax=docker/dockerfile:1
#
# Multi-stage build for the OpenAgentPlatform web UI (Vite + React).
# Build context is the repo root (see deploy/docker-compose.yml: context: ..).
# Produces static assets served by nginx.

# ---------- build stage ----------
FROM node:20-alpine AS build
WORKDIR /src

# Enable corepack so the pnpm version pinned in package.json is used. The web
# app is a pnpm package (pnpm-lock.yaml); the Makefile and this Dockerfile
# both use pnpm for consistency.
RUN corepack enable
# Copy the pnpm manifests first to cache deps.
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile

# Copy the web source and build the production bundle.
COPY web/ ./
RUN pnpm run build

# ---------- runtime stage ----------
FROM nginx:1.27-alpine AS runtime
# Ship a minimal nginx config that serves the SPA on :80 with a history-API
# fallback. The built assets land in /usr/share/nginx/html.
COPY --from=build /src/dist /usr/share/nginx/html
RUN printf 'server {\n\
  listen 80;\n\
  server_name _;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / { try_files $uri $uri/ /index.html; }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget -q --spider http://localhost/ || exit 1
