# Node
node_modules/
dist/
.pnpm-store/
# The web app is a pnpm workspace (pnpm-lock.yaml + pnpm-workspace.yaml);
# ignore npm's package-lock.json so a stray lockfile can't reintroduce
# toolchain ambiguity. The Makefile and Dockerfile use pnpm.
web/package-lock.json

# Python
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/

# Go
/bin/
/agent

# Env
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
coverage/
coverage.out
*.log

# Certs (keep directory, not contents)
deploy/nats/certs/*.pem
deploy/nats/certs/*.key
deploy/nats/certs/*.crt
.vite/ 
